# Enhanced HealthFlow AI Digital Prescription System v2.0
# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=Enhanced HealthFlow
APP_VERSION=2.0.0
FLASK_ENV=development
DEBUG=true
TESTING=false

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Generate secure keys using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-32-characters-minimum
JWT_SECRET_KEY=your-jwt-secret-key-here-32-characters-minimum
ENCRYPTION_KEY=your-encryption-key-here-32-characters-minimum

# Password security
PASSWORD_SALT_ROUNDS=12

# Session management
SESSION_TIMEOUT=3600
PERMANENT_SESSION_LIFETIME=28800

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
# Primary database
DATABASE_URL=postgresql://healthflow:healthflow@localhost:5432/healthflow

# Database connection pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Read replica (optional)
DATABASE_REPLICA_URL=postgresql://healthflow:healthflow@localhost:5432/healthflow_replica

# ============================================================================
# REDIS SETTINGS
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_CELERY_DB=3

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.1

# FHIR Server
FHIR_SERVER_URL=http://localhost:8080/fhir
FHIR_CLIENT_ID=your-fhir-client-id
FHIR_CLIENT_SECRET=your-fhir-client-secret

# ============================================================================
# INTERNATIONAL INTEGRATION
# ============================================================================

# Estonia X-Road Integration
XROAD_SECURITY_SERVER=https://your-xroad-server.ee
XROAD_CLIENT_ID=EE/GOV/12345678/healthflow
XROAD_SERVICE_ID=EE/GOV/87654321/prescription-service

# NHS CIS2 Integration (UK)
NHS_CIS2_ENDPOINT=https://am.nhsidentity.spineservices.nhs.uk
NHS_CIS2_CLIENT_ID=your-nhs-client-id
NHS_CIS2_CLIENT_SECRET=your-nhs-client-secret

# Netherlands MedCom Integration
MEDCOM_ENDPOINT=https://api.medcom.dk
MEDCOM_API_KEY=your-medcom-api-key

# Egyptian Health Services
UHIS_ENDPOINT=https://api.uhis.gov.eg
UHIS_API_KEY=your-uhis-api-key
MEDICAL_SYNDICATE_API=https://api.ems.org.eg

# ============================================================================
# EMAIL SETTINGS
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@healthflow.egypt.gov

# ============================================================================
# FILE STORAGE
# ============================================================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,doc,docx

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=healthflow-storage
AWS_S3_REGION=us-east-1

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/healthflow.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Sentry (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# RATE LIMITING
# ============================================================================
RATELIMIT_STORAGE_URL=redis://localhost:6379/4
RATELIMIT_DEFAULT=1000 per hour
RATELIMIT_HEADERS_ENABLED=true

# API-specific rate limits
API_RATE_LIMIT=100 per minute
AUTH_RATE_LIMIT=5 per minute
UPLOAD_RATE_LIMIT=10 per minute

# ============================================================================
# CACHING
# ============================================================================
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=healthflow:

# ============================================================================
# CELERY TASK QUEUE
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Africa/Cairo
CELERY_ENABLE_UTC=true

# ============================================================================
# INTERNATIONALIZATION
# ============================================================================
DEFAULT_LANGUAGE=en
BABEL_DEFAULT_LOCALE=en
BABEL_DEFAULT_TIMEZONE=Africa/Cairo

# ============================================================================
# CORS SETTINGS
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://healthflow.egypt.gov

# ============================================================================
# HEALTH CHECKS
# ============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=30

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=2555
GDPR_COMPLIANCE=true
HIPAA_COMPLIANCE=true

# Data retention
DATA_RETENTION_DAYS=2555
BACKUP_RETENTION_DAYS=90

# ============================================================================
# DEVELOPMENT SPECIFIC
# ============================================================================
# Only for development environment
MAIL_SUPPRESS_SEND=true
WTF_CSRF_ENABLED=false

# ============================================================================
# PRODUCTION SPECIFIC
# ============================================================================
# Only for production environment
# Ensure all security settings are properly configured
# Use strong, unique keys for all secret values
# Enable all monitoring and audit features
# Set appropriate rate limits
# Configure proper CORS origins
# Enable HTTPS only
# Set secure session cookies

# ============================================================================
# TESTING SPECIFIC
# ============================================================================
# Only for testing environment
# CELERY_TASK_ALWAYS_EAGER=true
# RATELIMIT_ENABLED=false

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================
HOST=0.0.0.0
PORT=5000

# Docker settings
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest

# Kubernetes settings
KUBERNETES_NAMESPACE=healthflow
KUBERNETES_CLUSTER=healthflow-cluster

# ============================================================================
# BACKUP SETTINGS
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_STORAGE_PATH=/backups
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit this file with real credentials to version control
# 2. Use environment-specific .env files (.env.development, .env.production)
# 3. Generate secure random keys for all secret values
# 4. Regularly rotate API keys and secrets
# 5. Use a secrets management system in production
# 6. Validate all URLs and endpoints before deployment
# 7. Test all integrations in staging environment first
# 8. Monitor all external service dependencies
# 9. Set up proper alerting for service failures
# 10. Document any custom configuration requirements

