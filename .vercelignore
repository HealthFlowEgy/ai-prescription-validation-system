# Vercel Ignore File for Enhanced HealthFlow
# Files and directories to exclude from Vercel deployment

# Development files
.env.local
.env.development
.env.test
*.log
logs/
temp/
tmp/

# Node modules (handled by Vercel)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
ENV/

# Database files (not needed in serverless)
*.db
*.sqlite
*.sqlite3
data/
backups/

# Docker files (not needed for Vercel)
Dockerfile*
docker-compose*.yml
.dockerignore

# Kubernetes files (not needed for Vercel)
deployment/kubernetes/
deployment/terraform/
deployment/docker/

# CI/CD files (handled separately)
.github/workflows/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test files and coverage
coverage/
.nyc_output
test-results/
htmlcov/
.coverage
.pytest_cache/

# Build artifacts (frontend will be built by Vercel)
dist/
build/
.next/

# Documentation (can be deployed separately)
docs/
*.md
!README.md

# Monitoring and infrastructure
monitoring/
prometheus_data/
grafana_data/

# Large files and uploads
uploads/
media/
static/uploads/

# Backup and migration files
migrations/
fixtures/

# Local configuration overrides
config/local.py
config/development_local.py

# Security scan results
bandit-report.json
safety-report.json
trivy-results.sarif

# Performance test results
performance-results.json
load-test-results/

# Certificates and keys
*.pem
*.key
*.crt
ssl/
certs/

# Archive files
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Temporary files
*.tmp
*.temp
*~
*.bak
*.backup
*.old
*.orig

