# Production Environment Configuration Template
# Copy this file to .env.production and fill in actual values
# DO NOT commit .env.production to version control

# =============================================================================
# CRITICAL - Must be set for production
# =============================================================================

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-min-32-chars-change-this
DEBUG=False

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-different-from-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database Configuration (PostgreSQL)
# Option 1: Full connection string
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Option 2: Individual components
DB_USER=prescription_user
DB_PASSWORD=secure_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prescription_validator_prod

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_MAX_OVERFLOW=20

# =============================================================================
# IMPORTANT - Highly recommended for production
# =============================================================================

# Monitoring and Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Celery (async task processing)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@prescriptionvalidator.com

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application Version
APP_VERSION=1.0.0
BUILD_DATE=2025-10-06
GIT_COMMIT=abc123def

# File Upload Configuration
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=16777216

# OCR Configuration
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/hour
RATELIMIT_LOGIN=5/minute
RATELIMIT_UPLOAD=10/minute
RATELIMIT_API=1000/hour

# =============================================================================
# FEATURE FLAGS
# =============================================================================

FEATURE_VOICE_INPUT=true
FEATURE_FHIR_INTEGRATION=true
FEATURE_SNOMED_LOOKUP=true

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# SNOMED CT Terminology Service
SNOWSTORM_URL=https://snowstorm.app.evidium.com
SNOWSTORM_TIMEOUT=10

# =============================================================================
# OPERATIONAL SETTINGS
# =============================================================================

# Maintenance Mode
MAINTENANCE_MODE=false

# Validation Settings
VALIDATION_TIMEOUT=30
MAX_MEDICATIONS_PER_PRESCRIPTION=20

# Audit & Backup
AUDIT_LOG_RETENTION_DAYS=365
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =============================================================================
# STAGING SPECIFIC (if using staging environment)
# =============================================================================

# Staging Database
STAGING_DATABASE_URL=postgresql://staging_user:password@staging-host:5432/staging_db
STAGING_DB_USER=staging_user
STAGING_DB_PASSWORD=staging_password
STAGING_DB_HOST=staging-host
STAGING_DB_PORT=5432
STAGING_DB_NAME=prescription_validator_staging
